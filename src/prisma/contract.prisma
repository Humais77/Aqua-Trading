// use prisma-next

model User {
  id           Uuid     @id @default(uuid())
  fullName     String
  username     String   @unique
  email        String   @unique
  passwordHash String
  referralCode String   @unique
  referredById Uuid?
  balance      Decimal  @default("0")
  profileImage String?
  role         UserRole @default(USER)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  referredBy   User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("UserReferrals")
  deposits     Deposit[]

  @@index([referredById])
}

enum UserRole {
  @@type("pg/text@1")

  USER
  ADMIN
}

model Deposit {
  id            Uuid          @id @default(uuid())
  userId        Uuid
  amount        Decimal
  method        DepositMethod
  reference     String        @unique
  status        DepositStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum DepositMethod {
  @@type("pg/text@1")

  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  RAAST
}

enum DepositStatus {
  @@type("pg/text@1")

  PENDING
  APPROVED
  REJECTED
}

model Plan {
  id           Uuid     @id @default(uuid())
  name         String   @unique
  tagline      String
  image        String
  investment   Decimal
  dailyProfit  Decimal
  days         Int
  totalProfit  Decimal
  referBonus   Decimal
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([isActive])
}